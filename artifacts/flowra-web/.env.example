VITE_API_BASE_URL=https://flowra.xenon54.co.kr/api/v1
# Google web OAuth client ID. Register the same ID in backend GOOGLE_OAUTH_CLIENT_IDS.
# Configure the deployed web origin (and localhost for development) in Google OAuth.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
